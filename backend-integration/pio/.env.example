# Merge these into the EXISTING backend environment; keep MongoDB/JWT settings.
CONTACT_MAIL_PROVIDER=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=sender@example.com
SMTP_PASS=replace-with-app-password
MAIL_FROM=PIO <sender@example.com>
CONTACT_EMAIL=enquiries@example.com
CORS_ORIGINS=http://localhost:5173,https://your-pio-frontend.example.com
# Render has one trusted ingress proxy. Adjust for other hosting topologies.
TRUST_PROXY_HOPS=1
# Optional alternative for Render Free: CONTACT_MAIL_PROVIDER=resend
RESEND_API_KEY=replace-only-if-using-resend

# Merge these into the EXISTING backend environment; keep MongoDB/JWT settings.
CONTACT_MAIL_PROVIDER=emailjs
EMAILJS_SERVICE_ID=replace-with-service-id
EMAILJS_TEMPLATE_ID=replace-with-contact-template-id
EMAILJS_PUBLIC_KEY=replace-with-public-key
EMAILJS_PRIVATE_KEY=replace-with-server-only-private-key
CONTACT_EMAIL=enquiries@example.com
# Configure the EmailJS template To Email as {{to_email}} and Reply To as {{reply_to}}.
# Use {{name}}, {{email}}, {{phone}}, {{inquiry_type}}, {{message}}, {{subject}}, {{submitted_at}} in the template body.
CORS_ORIGINS=http://localhost:5173,https://your-existing-car-booking-origin.example.com

# Alternative: CONTACT_MAIL_PROVIDER=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=sender@example.com
SMTP_PASS=replace-with-app-password
MAIL_FROM=PIO <sender@example.com>
# Render has one trusted ingress proxy. Adjust for other hosting topologies.
TRUST_PROXY_HOPS=1
# Optional alternative for Render Free: CONTACT_MAIL_PROVIDER=resend
RESEND_API_KEY=replace-only-if-using-resend
